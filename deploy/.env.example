# Copy to deploy/.env and change secrets.
POSTGRES_DB=ztna
POSTGRES_USER=ztna
POSTGRES_PASSWORD=change-me

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,orchestrator,orchestrator-agent-api

# First admin, created on first start if missing.
DJANGO_ADMIN_USERNAME=admin
DJANGO_ADMIN_PASSWORD=change-me-admin

# Shared secret identifying gw-1 to the orchestrator agent API (in addition to mTLS).
GATEWAY_TOKEN=change-me-gateway-token
GATEWAY_TOKEN_GW_2=change-me-gateway-2-token

# Single sign-on (Keycloak). Demo users olena/taras/iryna share SSO_DEMO_PASSWORD.
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak
OIDC_CLIENT_SECRET=change-me-oidc-client-secret
SSO_DEMO_PASSWORD=change-me-sso-demo
